# Hermes Agent - Environment Variables
# Updated for Ollama provider

# Telegram Bot Token
HERMES_TELEGRAM_BOT_TOKEN=8672394371:***

# Ollama API Key (if your Ollama instance requires auth)
# Local Ollama usually needs no key — leave as-is if running without auth
OLLAMA_API_KEY=540433a7504249c09c862d000b9e56db.0go1dZKldkLm1ODyy_HkEwFr

# Ollama Base URL — REQUIRED
# If Ollama is on your local PC, use a tunnel (ngrok/cloudflared) and paste the public URL here
# Example: OLLAMA_HOST=https://your-tunnel-url.ngrok-free.app
OLLAMA_HOST=

# Model name pulled in Ollama (e.g. llama3.2, mistral, qwen2.5, phi4)
HERMES_MODEL=auto

# Gateway port
PORT=10000

# Hermes home directory
HERMES_HOME=/home/hermes/.hermes
